#!/usr/bin/env python3
"""agentlog CLI launcher.

Resolves the bundled src/ tree relative to this script and invokes the CLI
entry point. Lets `agentlog` be runnable without a pip install during dev.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Point sys.path at the bundled src/ directory
_HERE = Path(__file__).resolve().parent
_SRC = _HERE.parent / "src"
if _SRC.is_dir():
    sys.path.insert(0, str(_SRC))

from agentlog.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
